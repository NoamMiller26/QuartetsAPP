<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="Quartets.Views.PlayerView"
    x:Name="Root">

    <Frame Padding="6" Margin="8" CornerRadius="12" BackgroundColor="WhiteSmoke">
        <VerticalStackLayout>

            <Label Text="{Binding Name}" FontAttributes="Bold" HorizontalOptions="Center"/>

            <!-- אם זה השחקן המקומי - מציגים את כל הקלפים -->
            <CollectionView ItemsSource="{Binding HandObservable}"
                            IsVisible="{Binding IsLocalPlayer}"
                            ItemsLayout="HorizontalList"
                            HeightRequest="80">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame Padding="6" Margin="4" HasShadow="False" BackgroundColor="White">
                            <Image Source="{Binding ImageSource}" WidthRequest="48" HeightRequest="72"/>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- אם לא שחקן מקומי - מציגים גב קלפים ושורה של מספר הקלפים -->
            <Grid IsVisible="{Binding IsLocalPlayer, Converter={StaticResource InverseBoolConverter}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- תצוגת גב קלף חוזרת לפי מספר הקלפים -->
                <CollectionView x:Name="BacksList"
                                ItemsSource="{Binding PlaceHolderBacks}"
                                ItemsLayout="HorizontalList"
                                HeightRequest="80"
                                Grid.Column="0">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Image Source="card_back.png" WidthRequest="48" HeightRequest="72" Margin="2"/>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <Label Text="{Binding HandObservable.Count, StringFormat='Cards: {0}'}" 
                       Grid.Column="1" 
                       VerticalOptions="Center"/>
            </Grid>

            <!-- כפתור לשאול את השחקן (מוצג רק עבור שחקנים אחרים) -->
            <Button Text="Ask" 
                    Command="{Binding AskCommand}" 
                    IsVisible="{Binding IsLocalPlayer, Converter={StaticResource InverseBoolConverter}}" />

        </VerticalStackLayout>
    </Frame>
</ContentView>
