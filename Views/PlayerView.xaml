<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="Quartets.Views.PlayerView"
    x:Name="Root">

    <Frame Padding="8" Margin="8" CornerRadius="12" BackgroundColor="#F7F5FF" HasShadow="True">
        <VerticalStackLayout Spacing="8">

            <Label Text="{Binding Name}" FontAttributes="Bold" HorizontalOptions="Center" TextColor="#3C2E86"/>
            <Label Text="{Binding CompletedSets, StringFormat='סטים: {0}'}"
                   FontSize="12"
                   HorizontalOptions="Center"
                   TextColor="#6E6B7B"/>

            <!-- אם זה השחקן המקומי - מציגים את כל הקלפים -->
            <CollectionView ItemsSource="{Binding HandObservable}"
                            IsVisible="{Binding IsLocalPlayer}"
                            ItemsLayout="HorizontalList"
                            HeightRequest="80">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame Padding="6" Margin="4" HasShadow="False" BackgroundColor="#EFEAFE" CornerRadius="8" BorderColor="#C6B8FF">
                            <Image Source="{Binding Source}" WidthRequest="48" HeightRequest="72" Aspect="AspectFit"/>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- אם לא שחקן מקומי - מציגים גב קלפים ושורה של מספר הקלפים -->
            <Grid IsVisible="{Binding IsLocalPlayer, Converter={StaticResource InverseBoolConverter}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- תצוגת גב קלף חוזרת לפי מספר הקלפים -->
                <CollectionView x:Name="BacksList"
                                ItemsSource="{Binding PlaceHolderBacks}"
                                ItemsLayout="HorizontalList"
                                HeightRequest="80"
                                Grid.Column="0">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Frame Padding="4" Margin="2" BackgroundColor="#D5CCFF" CornerRadius="6" HasShadow="False">
                                <Image Source="card_back.png" WidthRequest="42" HeightRequest="64" Aspect="AspectFit"/>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <Label Text="{Binding HandObservable.Count, StringFormat='Cards: {0}'}" 
                       Grid.Column="1" 
                       VerticalOptions="Center"
                       TextColor="#3C2E86"/>
            </Grid>

            <!-- כפתור לשאול את השחקן (מוצג רק עבור שחקנים אחרים) -->
            <Button Text="Ask" 
                    Command="{Binding AskCommand}" 
                    IsVisible="{Binding IsLocalPlayer, Converter={StaticResource InverseBoolConverter}}"
                    BackgroundColor="#5C4BDE"
                    TextColor="White"
                    CornerRadius="10"
                    Padding="10,6" />

        </VerticalStackLayout>
    </Frame>
</ContentView>
