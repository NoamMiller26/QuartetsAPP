<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:Quartets.Views"
             x:Class="Quartets.Views.GamePage">

    <ScrollView>
        <VerticalStackLayout Padding="12">
            <Label Text="Game Page" FontSize="20" HorizontalOptions="Center" />

            <!-- רשימה של שחקנים -->
            <CollectionView ItemsSource="{Binding Players}" ItemsLayout="VerticalList">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <views:PlayerView BindingContext="{Binding}" />
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- הקופה וכפתור תור -->
            <HorizontalStackLayout HorizontalOptions="Center" Margin="10">
                <Label Text="{Binding DeckCount, StringFormat='Deck: {0}'}" VerticalOptions="Center"/>
                <Button Text="Next Turn" Command="{Binding NextTurnCommand}" Margin="10,0"/>
            </HorizontalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
