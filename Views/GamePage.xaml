<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:Quartets.Views"
             x:Class="Quartets.Views.GamePage"
             BackgroundColor="#F4F1FF"
              BackgroundImageSource="background2.png"
             >

    <Grid RowDefinitions="Auto, *" Padding="16" RowSpacing="12">
        <!-- Header -->
        <VerticalStackLayout Spacing="6">
            <Label Text="Quartets" FontSize="24" FontAttributes="Bold" HorizontalOptions="Center" TextColor="#3C2E86"/>
            <Label Text="{Binding CurrentStatus}" FontSize="14" HorizontalOptions="Center" TextColor="Black"/>

            <!-- Turn timer "pill" -->
            <Frame IsVisible="{Binding IsTurnTimerVisible}"
                   Padding="10,6"
                   CornerRadius="18"
                   HasShadow="True"
                   HorizontalOptions="Center"
                   BackgroundColor="#3C2E86">
                <Label Text="{Binding RemainingSeconds, StringFormat='⏱ {0}s'}"
                       FontSize="18"
                       FontAttributes="Bold"
                       TextColor="White"
                       HorizontalOptions="Center"
                       VerticalOptions="Center">
                    <Label.Triggers>
                        <!-- Last 10 seconds: red background for urgency -->
                        <DataTrigger TargetType="Label" Binding="{Binding RemainingSeconds}" Value="10">
                            <Setter Property="TextColor" Value="White"/>
                        </DataTrigger>
                        <DataTrigger TargetType="Label" Binding="{Binding RemainingSeconds}" Value="9">
                            <Setter Property="TextColor" Value="White"/>
                        </DataTrigger>
                        <DataTrigger TargetType="Label" Binding="{Binding RemainingSeconds}" Value="8">
                            <Setter Property="TextColor" Value="White"/>
                        </DataTrigger>
                        <DataTrigger TargetType="Label" Binding="{Binding RemainingSeconds}" Value="7">
                            <Setter Property="TextColor" Value="White"/>
                        </DataTrigger>
                        <DataTrigger TargetType="Label" Binding="{Binding RemainingSeconds}" Value="6">
                            <Setter Property="TextColor" Value="White"/>
                        </DataTrigger>
                        <DataTrigger TargetType="Label" Binding="{Binding RemainingSeconds}" Value="5">
                            <Setter Property="TextColor" Value="White"/>
                        </DataTrigger>
                        <DataTrigger TargetType="Label" Binding="{Binding RemainingSeconds}" Value="4">
                            <Setter Property="TextColor" Value="White"/>
                        </DataTrigger>
                        <DataTrigger TargetType="Label" Binding="{Binding RemainingSeconds}" Value="3">
                            <Setter Property="TextColor" Value="White"/>
                        </DataTrigger>
                        <DataTrigger TargetType="Label" Binding="{Binding RemainingSeconds}" Value="2">
                            <Setter Property="TextColor" Value="White"/>
                        </DataTrigger>
                        <DataTrigger TargetType="Label" Binding="{Binding RemainingSeconds}" Value="1">
                            <Setter Property="TextColor" Value="White"/>
                        </DataTrigger>
                        <DataTrigger TargetType="Label" Binding="{Binding RemainingSeconds}" Value="0">
                            <Setter Property="TextColor" Value="White"/>
                        </DataTrigger>
                    </Label.Triggers>
                </Label>
            </Frame>
        </VerticalStackLayout>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="18">

                <!-- My Hand -->
                <Frame BackgroundColor="White" CornerRadius="14" HasShadow="True" Padding="12">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="הקלפים שלי" FontAttributes="Bold" TextColor="#3C2E86"/>
                        <Label Text="{Binding CompletedSets, StringFormat='סטים שהושלמו: {0}'}"
                               FontSize="12"
                               TextColor="#6E6B7B"
                               HorizontalOptions="Start"/>
                        <CollectionView ItemsSource="{Binding PlayerHand}"
                                        ItemsLayout="HorizontalList"
                                        HeightRequest="130">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Frame Padding="6" Margin="4" HasShadow="False" BackgroundColor="#EFEAFE" CornerRadius="10" BorderColor="#C6B8FF">
                                        <Image Source="{Binding Source}" WidthRequest="70" HeightRequest="100" Aspect="AspectFit"/>
                                    </Frame>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                            <CollectionView.EmptyView>
                                <Label Text="אין לך קלפים כרגע" TextColor="#9A8FC3" HorizontalOptions="Center"/>
                            </CollectionView.EmptyView>
                        </CollectionView>
                    </VerticalStackLayout>
                </Frame>

                <!-- Opponents -->
                <Frame BackgroundColor="White" CornerRadius="14" HasShadow="True" Padding="12">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="שחקנים אחרים" FontAttributes="Bold" TextColor="#3C2E86"/>
                        <CollectionView ItemsSource="{Binding Opponents}" ItemsLayout="VerticalList">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <views:PlayerView BindingContext="{Binding}" />
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                            <CollectionView.EmptyView>
                                <Label Text="אין יריבים מחוברים" TextColor="#9A8FC3" HorizontalOptions="Center"/>
                            </CollectionView.EmptyView>
                        </CollectionView>
                    </VerticalStackLayout>
                </Frame>

                <!-- Deck -->
                <Frame BackgroundColor="White" CornerRadius="14" HasShadow="True" Padding="12">
                    <HorizontalStackLayout HorizontalOptions="Center" Spacing="16">
                        <Grid>
                            <Frame WidthRequest="60" HeightRequest="85" BackgroundColor="#D5CCFF" CornerRadius="8" HasShadow="False" />
                            <Label Text="{Binding DeckCount}" HorizontalOptions="Center" VerticalOptions="Center" FontAttributes="Bold" TextColor="#3C2E86"/>
                        </Grid>
                        <Label Text="קופה" VerticalOptions="Center" TextColor="#3C2E86"/>
                    </HorizontalStackLayout>
                </Frame>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
