<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                        xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
               xmlns:vm="clr-namespace:Quartets.ViewModels"
               xmlns:m="clr-namespace:Quartets.Models"
               x:Class="Quartets.Views.WinningPopup"
               x:DataType="vm:WinningPopupVM">
    <VerticalStackLayout Background="Aqua">
        <Label Text="{Binding WinnerName}"
    FontSize="16"
  Margin="8,0"/>
    </VerticalStackLayout>

</toolkit:Popup>