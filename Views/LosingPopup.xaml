<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                        xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
               xmlns:vm="clr-namespace:Quartets.ViewModels"
               xmlns:m="clr-namespace:Quartets.Models"
               x:Class="Quartets.Views.LosingPopup"
               x:DataType="vm:LosingPopupVM">
    <VerticalStackLayout Background="Aqua">
        <Label Text="You Lost!"
               FontSize="20"
               FontAttributes="Bold"
               HorizontalOptions="Center"
               Margin="8,16"/>
        <Label Text="{Binding WinnerName, StringFormat='Winner: {0}'}"
               FontSize="16"
               HorizontalOptions="Center"
               Margin="8,0"/>
    </VerticalStackLayout>

</toolkit:Popup>